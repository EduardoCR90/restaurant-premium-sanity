# URL canónica real antes de publicar. No desplegar con el dominio de ejemplo.
SITE_URL=https://eduardocr90.github.io
# Sin estos dos valores se utiliza exclusivamente el contenido demo.
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Solo necesario para dataset privado; lectura mínima, disponible solo en build.
SANITY_API_READ_TOKEN=
# Por defecto un fallo del CMS detiene la build. Solo desarrollo: true para demo visible.
SANITY_ALLOW_DEMO_FALLBACK=false
# Studio usa únicamente identificadores públicos, nunca tokens privados.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
