# Identificadores públicos del proyecto existente. No son credenciales.
SITE_URL=https://eduardocr90.github.io
# / para dominio propio; conserva la base de Pages por defecto.
SITE_BASE=/restaurant-premium-sanity
SANITY_PROJECT_ID=hfa8zkyw
SANITY_DATASET=production
# false: consulta Sanity. true: demo local/CI sin acceder a la red.
SANITY_USE_MOCK=false
# Un dataset vacío usa demo automáticamente. Fallos de red/datos inválidos fallan la build.
SANITY_ALLOW_DEMO_FALLBACK=false
# Solo datasets privados: token de lectura mínimo, disponible exclusivamente en build.
SANITY_API_READ_TOKEN=
# Variables SANITY_STUDIO_* y SANITY_AUTH_TOKEN: solo en el repositorio independiente
# EduardoCR90/studio-salitre-restaurant. Consulta docs/sanity-setup.md.
