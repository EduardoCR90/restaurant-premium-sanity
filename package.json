    "seed:export": "tsx scripts/export-seed.ts"
  },
  "dependencies": {
    "astro": "^5.13.0",
    "@sanity/client": "^7.11.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.2",
    "sanity": "^4.10.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "@types/react": "^19.1.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "styled-components": "^6.1.19"
  }
}
