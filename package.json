{
  "name": "salitre-restaurant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && tsc --project sanity/tsconfig.json --noEmit",
    "build": "astro build",
