---
import type { Content } from '../types/content';
interface Props { settings: Content['settings']; }
const { settings } = Astro.props;
---
<footer class="site-footer wrap">
 <div class="footer-top"><a class="wordmark" href="/">{settings.name}</a><p>{settings.tagline}<br/>El lujo de estar aquí.</p><a class="text-link" href="/reservas/">Encuéntranos <span aria-hidden="true">↗</span></a></div>
 <div class="footer-bottom"><span>© {new Date().getFullYear()} {settings.name}</span><span>{settings.isFictional ? 'Restaurante ficticio · Proyecto de demostración' : settings.address}</span><a href="#top">Volver arriba ↑</a></div>
</footer>
