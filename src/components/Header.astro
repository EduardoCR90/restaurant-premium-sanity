---
import { pathFor } from '../lib/paths';
interface Props { name: string; }
const { name } = Astro.props;
const links = [{ href:pathFor('/'),label:'Inicio' },{ href:pathFor('/carta/'),label:'La carta' },{ href:pathFor('/restaurante/'),label:'La casa' },{ href:pathFor('/reservas/'),label:'Reservas' }];
---
<header class="site-header wrap" transition:name="site-header" transition:animate="none">
 <a href={pathFor('/')} class="wordmark" aria-label={`${name} · Inicio`}>{name}<span>COCINA DE ORIGEN</span></a>
 <nav aria-label="Navegación principal">{links.map(link => <a href={link.href} data-astro-prefetch aria-current={Astro.url.pathname === link.href ? 'page' : undefined}>{link.label}</a>)}</nav>
</header>
