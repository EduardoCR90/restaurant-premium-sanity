---
import type { EditorialImage } from '../types/content';
interface Props { image: EditorialImage; eager?: boolean; class?: string; sizes?: string; }
const { image, eager = false, class: className, sizes = '(max-width: 700px) 100vw, 60vw' } = Astro.props;
const supported = ['images.unsplash.com', 'cdn.sanity.io'].includes(new URL(image.url).hostname);
function sized(width: number) { const url = new URL(image.url); if (supported) { url.searchParams.set('w', String(width)); url.searchParams.set('auto', 'format'); url.searchParams.set('fit', 'max'); } return url.toString(); }
---
<img class={className} src={sized(1440)} srcset={supported ? [480,800,1200,1800,2400].map(w => `${sized(w)} ${w}w`).join(', ') : undefined} sizes={sizes} alt={image.alt} width="1600" height="1100" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />
