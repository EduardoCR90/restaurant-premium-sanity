---
import { pathFor } from '../lib/paths';
interface Props {visible:boolean;}
const {visible} = Astro.props;
---
{visible && <section class="reservation-band wrap"><p class="eyebrow">El tiempo, a tu favor</p><h2>Quédate<br/><em>un poco más.</em></h2><a class="text-link" href={pathFor('/reservas/')} data-astro-prefetch>Tu próxima mesa <span aria-hidden="true">↗</span></a></section>}
