---
import { pathFor } from '../lib/paths';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { ContentResult } from '../types/content';
interface Props { data: ContentResult; slug: 'inicio' | 'carta' | 'restaurante' | 'reservas'; }
const { data, slug } = Astro.props;
const { settings } = data.content;
const page = data.content.pages.find(page => page.slug === slug)!;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = page.seo.image?.url || page.image?.url;
const demo = data.source === 'demo' || settings.isFictional || canonical.hostname.endsWith('.example');
---
<!doctype html>
<html lang="es"><head>
 <meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
 <title>{page.seo.title}</title><meta name="description" content={page.seo.description}/>
 <link rel="canonical" href={canonical}/><meta name="theme-color" content="#ece8df"/>
 {demo && <meta name="robots" content="noindex, follow"/>}
 <meta property="og:type" content="website"/><meta property="og:locale" content="es_ES"/>
 <meta property="og:title" content={page.seo.title}/><meta property="og:description" content={page.seo.description}/><meta property="og:url" content={canonical}/><meta property="og:site_name" content={settings.name}/>
 {ogImage && <meta property="og:image" content={ogImage}/>}
 <meta name="twitter:card" content="summary_large_image"/>
 <link rel="icon" href={pathFor('/favicon.svg')} type="image/svg+xml"/>
 <link rel="preconnect" href="https://images.unsplash.com"/>
</head><body id="top">
 <a class="skip-link" href="#contenido">Saltar al contenido</a>
 <Header name={settings.name}/>
 {data.source === 'demo' && <aside class="demo-notice">{data.warning || 'Proyecto de demostración · Restaurante y datos ficticios · Reservas no activas'}</aside>}
 <main id="contenido"><slot/></main>
 <Footer settings={settings}/>
</body></html>
