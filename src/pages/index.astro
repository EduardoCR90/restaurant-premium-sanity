---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import ReservationCTA from '../components/ReservationCTA.astro';
import { getContent, formatPrice } from '../lib/content';
const data = await getContent();
const { settings, story, dishes } = data.content;
const page = data.content.pages.find(p => p.slug === 'inicio')!;
const featured = dishes.filter(d => d.featured && d.available).slice(0,3);
---
<BaseLayout data={data} slug="inicio">
 <section class="hero wrap">
  <div class="hero-heading"><p class="eyebrow">{page.eyebrow}</p><h1 class="preserve-lines">{page.title}</h1></div>
  <div class="hero-photo">{page.image && <Photo image={page.image} eager sizes="(max-width: 700px) 100vw, 72vw"/>}<span class="photo-caption">01 / Una mesa abierta al Atlántico</span></div>
  <div class="hero-note"><span class="coordinate" aria-hidden="true">28°28′ N<br/>16°15′ O</span><p>{page.intro}</p><a class="text-link" href="/carta/">Descubrir la carta <span aria-hidden="true">↗</span></a></div>
  <span class="hero-side" aria-hidden="true">TIERRA · FUEGO · ATLÁNTICO</span>
 </section>
 <section class="concept wrap"><p class="eyebrow">01 — Nuestra esencia</p><div><h2>Lo extraordinario<br/>está en <em>el origen.</em></h2><p class="body-copy">{settings.concept}</p><a class="text-link" href="/restaurante/">La filosofía de la casa <span aria-hidden="true">↗</span></a></div></section>
 <section class="featured wrap"><div class="section-heading"><p class="eyebrow">02 — En temporada</p><h2>La isla, <em>en tres actos.</em></h2><a class="text-link" href="/carta/">Ver toda la carta ↗</a></div>
 <div class="dish-editorial">{featured.map((dish,index) => <article><div class="dish-photo">{dish.image && <Photo image={dish.image} sizes="(max-width: 700px) 100vw, 33vw"/>}<span>0{index+1}</span></div><div class="dish-heading"><h3>{dish.name}</h3><span>{formatPrice(dish.price)}</span></div><p>{dish.description}</p></article>)}</div>
 {featured.length === 0 && <p class="empty-state">La próxima selección de temporada está en preparación. Consulta nuestra carta.</p>}
 </section>
 <section class="story-preview"><div class="story-image">{story.image && <Photo image={story.image}/>}</div><div class="story-copy"><p class="eyebrow">03 — La casa</p><h2 class="preserve-lines">{story.title}</h2><p>{story.body}</p><a class="text-link" href="/restaurante/">Nuestra historia ↗</a></div></section>
 <ReservationCTA/>
</BaseLayout>
