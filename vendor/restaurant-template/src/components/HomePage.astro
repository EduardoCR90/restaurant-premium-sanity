---
import {pageCopy} from '../lib/editorial';
import EditorialHeading from './EditorialHeading.astro';
import EditorialLink from './EditorialLink.astro';
import Photo from '../components/Photo.astro';
import ReservationCTA from '../components/ReservationCTA.astro';
import { formatPrice } from '../lib/format';
import type { ContentResult } from '../types/content';
interface Props {data:ContentResult;}
const {data} = Astro.props;
const { settings, story, dishes } = data.content;
const page = data.content.pages.find(p => p.slug === 'inicio')!;
const copy=pageCopy(page);
const featured = dishes.filter(d => d.featured && d.available && d.visible && data.content.categories.some(c => c._id === d.categoryId && c.visible)).slice(0,3);
---

 <section class="hero wrap">
  <div class="hero-heading"><p class="eyebrow">{page.eyebrow}</p><h1 class="preserve-lines">{page.title}</h1></div>
  <div class="hero-photo">{page.image && <Photo image={page.image} eager sizes="(max-width: 700px) 100vw, 72vw"/>}<span class="photo-caption">{copy.hero.caption}</span></div>
  <div class="hero-note"><span class="coordinate" aria-hidden="true">{copy.hero.coordinates.split('\n').map((line,i)=><Fragment>{i>0&&<br/>}{line}</Fragment>)}</span><p>{page.intro}</p><EditorialLink content={data.content} link={copy.hero.link}/></div>
  <span class="hero-side" aria-hidden="true">{copy.hero.sideNote}</span>
 </section>
 <section class="concept wrap"><p class="eyebrow">{copy.essence.eyebrow}</p><div><h2><EditorialHeading heading={copy.essence.heading}/></h2><p class="body-copy">{settings.concept}</p><EditorialLink content={data.content} link={copy.essence.link}/></div></section>
 <section class="featured wrap"><div class="section-heading"><p class="eyebrow">{copy.featured.eyebrow}</p><h2><EditorialHeading heading={copy.featured.heading}/></h2><EditorialLink content={data.content} link={copy.featured.link}/></div>
 <div class="dish-editorial">{featured.map((dish,index) => <article><div class="dish-photo">{dish.image && <Photo image={dish.image} sizes="(max-width: 700px) 100vw, 33vw"/>}<span>0{index+1}</span></div><div class="dish-heading"><h3>{dish.name}</h3><span>{formatPrice(dish.price)}</span></div><p>{dish.description}</p></article>)}</div>
 {featured.length === 0 && <p class="empty-state">{copy.featured.empty}</p>}
 </section>
 <section class="story-preview"><div class="story-image">{story.image && <Photo image={story.image}/>}</div><div class="story-copy"><p class="eyebrow">{copy.storyPreview.eyebrow}</p><h2 class="preserve-lines">{story.title}</h2><p>{story.body}</p><EditorialLink content={data.content} link={copy.storyPreview.link}/></div></section>
 <ReservationCTA content={data.content}/>

