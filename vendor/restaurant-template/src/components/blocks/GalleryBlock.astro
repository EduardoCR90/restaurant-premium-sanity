---
import Photo from '../Photo.astro';
import type {BlockOf} from '../../types/blocks';
interface Props {block:BlockOf<'galleryBlock'>;}
const {block} = Astro.props;
---
<section class:list={['dynamic-block','gallery','wrap',`variant-${block.variant}`]}>{block.title && <h2>{block.title}</h2>}<div class="gallery-composition">{block.images.map(image => <figure><Photo image={image}/><figcaption>{image.alt}</figcaption></figure>)}</div></section>
